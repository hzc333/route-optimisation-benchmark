{
  "$defs": {
    "Route": {
      "additionalProperties": false,
      "properties": {
        "vehicle_id": {
          "title": "Vehicle Id",
          "type": "string"
        },
        "job_ids": {
          "items": {
            "type": "string"
          },
          "title": "Job Ids",
          "type": "array"
        },
        "arrival_times": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival Times"
        },
        "loads": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loads"
        }
      },
      "required": [
        "vehicle_id",
        "job_ids"
      ],
      "title": "Route",
      "type": "object"
    },
    "SolverStatus": {
      "enum": [
        "SOLVED",
        "NO_SOLUTION",
        "TIMEOUT",
        "ERROR"
      ],
      "title": "SolverStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "problem_name": {
      "title": "Problem Name",
      "type": "string"
    },
    "solver": {
      "title": "Solver",
      "type": "string"
    },
    "solver_version": {
      "title": "Solver Version",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "time_limit_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time Limit S"
    },
    "threads": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Threads"
    },
    "status": {
      "$ref": "#/$defs/SolverStatus"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/Route"
      },
      "title": "Routes",
      "type": "array"
    },
    "unserved": {
      "items": {
        "type": "string"
      },
      "title": "Unserved",
      "type": "array"
    },
    "solver_runtime_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Solver Runtime S"
    },
    "wall_runtime_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wall Runtime S"
    },
    "native_objective": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Objective"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "problem_name",
    "solver",
    "solver_version",
    "status"
  ],
  "title": "Solution",
  "type": "object"
}
